    $ style.default.language = "eastasian"
    define mc = Character(_("忘尘仙子/我"))
    define mc_1 = Character(_("慕容凌/我"))
    define one = Character(_("大郎"))
    define two = Character(_("二郎" ))
    define three = Character(_("三郎"))
    define four = Character(_("四郎" ))
    define five = Character(_("五郎" ))
    define six = Character(_("六郎" ))
    define seven = Character(_("七郎" ))
    define dude9 = Character(_("摩昂太子"))
    define zuc = Character(_("茄子"))
    define dude1 = Character(_("天帝"))
    define dude2 = Character(_("阎王" ))
    define npc2 = Character(_("陛下"))
    define girl_1 = Character(_("阿轩" ))
    define dude3 = Character(_("温柔少年" ))
    define dude4 = Character(_("冷漠少年" ))
    define dude5 = Character(_("老板" ))
    define girl_2 = Character(_("少女" ))
    define dude6 = Character(_("青衣少年" ))
    define boy = Character(_("少年" ))
    define lady = Character(_("掌柜" ))
    define npc1 = Character(_("国师" ))
    define f1 = Character(_("九妹" ))
    define mom = Character(_("娘" ))
    define z = Character(_("老张" ))
    define b = Character(_("表叔" ))
    define dude7 = Character(_("少年" ))
    define dude8 = Character(_("陌生男子"))
    define mc2 = Character(_("萧瑀"))
# 游戏在此开始。

label splashscreen:
    play music "audio/music_main.mp3"
    scene game_menu
    menu:
        "Chinese/中文":
            $ renpy.change_language(None)
            $ MainMenu(confirm=False)()
        "English/英文":
            $ renpy.change_language("english")
            $ MainMenu(confirm=False)()

label start:
    $ one_l = 0
    $ two_l = 0
    $ three_l = 0
    $ four_l = 0
    $ five_l = 0
    $ six_l = 0
    $ dr_l = 0
    $ virtue = 0
    $ det = 0
    play music "audio/music0.mp3"
    scene 20
    "人人都知道天帝有七个儿子，而每位仙君传说都是春闺少女的梦中人。"
    "天庭里，人人都称呼他们为“\郎君”\。 若是长子， 就是“大郎”， 次子为“二郎”，三子是“三郎”。 以此类推。"
    "这千年间，仙君们一直都在修行,偶尔去凡间逛逛。让人出乎意外的是一介凡人董永竟然和七郎在人间定情。想到这里，我就纳闷了。"
    "我好歹也是掌管天河十万水军的统帅，怎么和七郎百年的相识都抵不过凡间的数十年?"
    "其余的仙君是否哪天也会钟情于人呢？"
    "本来七郎和董永之间是一段美谈，可当天帝知道这段姻缘后，七郎就被逐出了天庭。"
    "从此以后，其余六位仙君也不能与人间的凡夫俗子有任何往来。"
    "每次几位仙君修炼出关后，我都有买他们定制的丹药，送各种奇珍异宝只为博君一笑。"
    "以往买了丹药之后，我开心的能添两碗饭。随便就能和土地公吃一只烧鸡，顺便和八仙下个棋。"
    "可是我今天却有些惆怅，因为又一位仙君被定下了婚约。"
    show 3 with dissolve
    "我的手下，茄子，一直专注在桌上的菜，也不帮我好好分析。看到他的苦瓜脸，我就知道只能靠自己了。"
    zuc "元帅现在不缺权利，声望，何必为情所困呢？来来，我从月老那里拿了一罐上好的酒，小的给您满上。"
    show 2 with dissolve
    mc "(喝了一口)这是什么酒啊？怎么感觉有些兴奋？"
    show 3 with dissolve
    zuc "(点头)这是我专门给您找来壮胆的呀，您不是喜欢那几位仙君吗? 有句话是什么来着？什么鲜花和什么牛X？"
    zuc "所以您和那些仙君的迷妹们就差一杯壮胆酒，来来，我再给您满上-- "
    show 2 with dissolve
    "看来茄子以为我喝醉了，他这是在贬低老娘啊， 我选择"
    menu:
        "沉默":
            "茄子是不是觉得本仙子好欺负？"
            "我二话没说直接就把酒倒在他的头上，他震惊了一秒后，马上又笑脸相迎"
            jump scene1_1
        "反手就是一巴掌":
            $ det += 5
            "坚定 +5"
            "虽然我有些醉了，可是茄子这话中话，我倒是听出来了。我随手也就是一巴掌扇在他的脸上。"
            jump scene1_1
    label scene1_1:
        "由于我的武力值超高，茄子被我揍到脸变成臃肿后才反应过来，他马上就跪地求饶。"
        play sound "audio/door.mp3"
        "我的脸慢慢发烫，看来这酒还挺烈的。我随手打开门，离开了我的府邸。"
        play music "audio/music_1.mp3"
        show 41 with dissolve
        "随着醉意，我漫步到了天庭以南的竹林外。"
        "我到底是钟情于哪种仙君呢？ (先保存，每个都看看吧）"
        menu:
